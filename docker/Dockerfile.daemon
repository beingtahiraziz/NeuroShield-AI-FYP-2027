# docker/Dockerfile.daemon
# =============================================================================
# Headless SOC daemon — autonomous orchestrator, no HTTP frontend
#
# Final image runs:  python daemon/main.py
# Exposes ports:
#   8081  webhook receiver  (DAEMON_WEBHOOK_PORT)
#   9090  Prometheus metrics (DAEMON_METRICS_PORT)
#   9091  health / status   (DAEMON_HEALTH_PORT)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: install Python dependencies
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS python-deps

WORKDIR /install

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# requirements.txt pins the submodules as editable installs (`-e ./<dir>`)
# for local development. In the image we install them as regular packages
# from the copied source, so the runtime stage needs only /usr/local and no
# editable source tree (an `-e` install writes a .pth pointing at the build
# path, which won't exist in the runtime stage). Keep this COPY list in sync
# with the `-e ./` lines in requirements.txt: neuroshield-core, mcp-servers,
# mempalace.
COPY requirements.txt .
COPY neuroshield-core/ ./neuroshield-core/
COPY mcp-servers/    ./mcp-servers/
COPY mempalace/      ./mempalace/
RUN grep -vE '^[[:space:]]*-e[[:space:]]+\./' requirements.txt > requirements.runtime.txt \
    && pip install --no-cache-dir --prefix=/install/deps \
         -r requirements.runtime.txt \
         ./neuroshield-core ./mcp-servers ./mempalace

# ---------------------------------------------------------------------------
# Stage 2: runtime image
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ARG NEUROSHIELD_VERSION=dev
LABEL org.opencontainers.image.version="${NEUROSHIELD_VERSION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
      libpq5 \
      curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r neuroshield && useradd -r -g neuroshield -d /app -s /sbin/nologin neuroshield

WORKDIR /app

COPY --from=python-deps /install/deps /usr/local

# Daemon-specific source
COPY --chown=neuroshield:neuroshield daemon/      ./daemon/
COPY --chown=neuroshield:neuroshield backend/     ./backend/
COPY --chown=neuroshield:neuroshield core/        ./core/
COPY --chown=neuroshield:neuroshield services/    ./services/
COPY --chown=neuroshield:neuroshield tools/       ./tools/
COPY --chown=neuroshield:neuroshield database/    ./database/
COPY --chown=neuroshield:neuroshield data/        ./data/
COPY --chown=neuroshield:neuroshield workflows/   ./workflows/
COPY --chown=neuroshield:neuroshield mcp-servers/ ./mcp-servers/
COPY --chown=neuroshield:neuroshield mempalace/   ./mempalace/
COPY --chown=neuroshield:neuroshield VERSION      ./VERSION
COPY --chown=neuroshield:neuroshield setup.cfg    ./setup.cfg

# Persistent investigation artifacts (mount a PVC here in K8s)
RUN mkdir -p /app/data/investigations /app/data/mempalace \
    && chown -R neuroshield:neuroshield /app/data

RUN echo "${NEUROSHIELD_VERSION}" > /app/VERSION

USER neuroshield

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    DAEMON_WEBHOOK_PORT=8081 \
    DAEMON_METRICS_PORT=9090 \
    DAEMON_HEALTH_PORT=9091

EXPOSE 8081 9090 9091

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:9091/health || exit 1

CMD ["python", "daemon/main.py"]
